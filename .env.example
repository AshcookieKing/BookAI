# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# --- OpenAI / совместимый API (story_engine, часть gemini_image) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# APIYI_BASE_URL=

OPENAI_STORY_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1-hd

# --- Telegram (bot.py) ---
TELEGRAM_BOT_TOKEN=

# Опционально: удаление пользовательских команд в чате (1/true — включено)
# BOT_DELETE_USER_COMMANDS=1

# --- Gemini / изображения (gemini_image.py) ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# APIYI_GEMINI_HOST=https://api.apiyi.com
# NANO_IMAGE_ASPECT_RATIO=1:1
# NANO_IMAGE_SIZE=1K

# --- Режимы генерации картинок (story_engine) ---
